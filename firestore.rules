rules_version = '2';

// Security rules for the multiplayer "versus" feature.
// Paste into Firebase console → Firestore → Rules → Publish.
//
// Cleanup: matches and player docs are stamped with an `expireAt` timestamp
// (see EXPIRE_AFTER_MS in lib/versus.ts). Create two TTL policies once so old
// games are swept automatically with no backend. TTL lives in the Google Cloud
// console (Firestore → Time-to-live), not the Firebase console — or via gcloud:
//   gcloud firestore fields ttls update expireAt --collection-group=matches --enable-ttl
//   gcloud firestore fields ttls update expireAt --collection-group=players --enable-ttl
//
// Integrity ceiling (by design, no paid Cloud Functions): answer *correctness*
// is trusted from the client, and the answer key lives in the match doc. These
// rules do lock down: auth required for all access, host-only match transitions,
// immutable questions/config, and you can only write your own player document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /matches/{code} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby';

      // Only the host may change match-level state (start / finish); the
      // question set and config are frozen once created.
      allow update: if request.auth != null
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.questions == resource.data.questions
        && request.resource.data.config == resource.data.config;

      allow delete: if false;

      match /players/{uid} {
        allow read: if request.auth != null;
        // A player can only create/update their own document.
        allow create, update: if request.auth != null && uid == request.auth.uid;
        allow delete: if false;
      }
    }
  }
}
