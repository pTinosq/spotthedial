# Firebase config for the multiplayer "versus" mode.
# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# These keys are public by design — Firestore security rules (see firestore.rules) do the protecting.
# Leave unset to disable versus; the rest of the site is unaffected.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
